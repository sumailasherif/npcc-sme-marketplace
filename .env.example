# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git. NEVER commit real keys.
# On Vercel, add the same variables under Project Settings > Environment Variables.

# --- Public (sent to the browser; safe to expose) -------------------------
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable key" (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Base URL of the site, used for shop links and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (secret; never prefix with NEXT_PUBLIC_) ------------------
# "Secret key" (sb_secret_...). The legacy "service_role" key also works.
# Bypasses Row Level Security, so use it only in admin server code.
SUPABASE_SECRET_KEY=
# AI for listing and reply drafts (needed from M2). Any OpenAI-compatible API.
# Default: OpenCode Console pay-as-you-go (opencode.ai/console > API keys).
AI_BASE_URL=https://opencode.ai/inference/openai/v1
AI_API_KEY=
# Model ID from the provider's model list, e.g. a vision-capable model.
AI_MODEL=deepseek-v4.1-flash
# Resend API key for order emails (needed from M3).
RESEND_API_KEY=
