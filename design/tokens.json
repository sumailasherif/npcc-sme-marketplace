{
  "$description": "Bazar design tokens. Source of truth until the Figma export (Tokens Studio) replaces this file. Must stay in sync with src/app/globals.css (checked by tests/unit/tokens.test.ts).",
  "color": {
    "teal-50": "#E6F4F5",
    "teal-100": "#C2E5E7",
    "teal-500": "#0E7C86",
    "teal-700": "#0A5C63",
    "coral-100": "#FDE3DD",
    "coral-500": "#F05A3C",
    "coral-700": "#C0402A",
    "yellow-100": "#FDF1D6",
    "yellow-500": "#F6B93B",
    "ink-100": "#E7EDEF",
    "ink-300": "#B8C6CB",
    "ink-500": "#5E747D",
    "ink-700": "#35505A",
    "ink-900": "#0F2A33",
    "sand-50": "#FAF6EF",
    "white": "#FFFFFF",
    "success-500": "#2E9E6B",
    "success-700": "#237A53",
    "error-600": "#B83232"
  },
  "font": {
    "heading": "Plus Jakarta Sans",
    "body": "Inter"
  },
  "text": {
    "display": { "font": "heading", "size": 32, "lineHeight": 40, "weight": 800 },
    "h1": { "font": "heading", "size": 24, "lineHeight": 32, "weight": 700 },
    "h2": { "font": "heading", "size": 20, "lineHeight": 28, "weight": 700 },
    "h3": { "font": "heading", "size": 17, "lineHeight": 24, "weight": 600 },
    "body-l": { "font": "body", "size": 16, "lineHeight": 24, "weight": 400 },
    "body": { "font": "body", "size": 14, "lineHeight": 20, "weight": 400 },
    "label": { "font": "body", "size": 13, "lineHeight": 16, "weight": 600 },
    "caption": { "font": "body", "size": 12, "lineHeight": 16, "weight": 500 },
    "price": { "font": "body", "size": 18, "lineHeight": 24, "weight": 700 }
  },
  "spacing": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64],
  "radius": {
    "chip": 6,
    "button": 10,
    "card": 16,
    "sheet": 24
  },
  "shadow": {
    "e1": "0 1px 2px rgb(15 42 51 / 0.08)",
    "e2": "0 4px 12px rgb(15 42 51 / 0.10)",
    "e3": "0 12px 24px rgb(15 42 51 / 0.14)"
  },
  "breakpoint": {
    "mobile": 360,
    "tablet": 768,
    "desktop": 1280
  },
  "touchTarget": 44
}
